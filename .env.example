# JIRA ASSIGN AI - PRODUCTION ENVIRONMENT TEMPLATE
# Instructions: Copy this to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# --- DATABASE ---
POSTGRES_USER=jira_admin
POSTGRES_PASSWORD=FILL_ME_STRONG_PASSWORD
POSTGRES_DB=jira_assign_db
DATABASE_URL=postgresql://jira_admin:FILL_ME_STRONG_PASSWORD@db:5432/jira_assign_db

# --- SECURITY ---
# Generate a 32-byte key for encryption (Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=FILL_ME_GENERATED_KEY

# Generate a long random string for JWT: openssl rand -hex 32
JWT_SECRET=FILL_ME_RANDOM_HEX

# Admin login for the dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_SOMETHING_STRONG

# --- API SETTINGS ---
JWT_EXPIRE_HOURS=24
# Set to true if deploying behind HTTPS (e.g. Corporate TLS Proxy)
SECURE_COOKIES=false

# The port where the application will be accessible on the host machine
APP_PORT=80

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
